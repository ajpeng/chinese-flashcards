// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  passwordHash  String      @default("") // empty for OAuth-only users
  patreonId     String?     @unique       // Patreon user ID (null for legacy email/pw users)
  name          String?
  emailVerified DateTime?
  pinyinStyle   String      @default("marks") // "marks" or "numbers"
  fontSize      String      @default("medium") // "small" | "medium" | "large" | "xlarge"
  speechRate    Float       @default(0.8)
  voiceName     String?     // Name of preferred TTS voice
  textVariant   String      @default("simplified") // "simplified" | "traditional"
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  flashcards    Flashcard[]
  articles      Article[]

  @@index([email])
  @@index([patreonId])
}

model Article {
  id        Int      @id @default(autoincrement())
  title     String
  hskLevel  Int?
  content   String
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words     Word[]
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Word {
  id         Int         @id @default(autoincrement())
  simplified String
  pinyin     String?
  english    String?
  hskLevel   Int?
  articleId  Int?                                          // null for standalone HSK vocabulary words
  source     String?     @default("dictionary")           // "dictionary" | "ai" | "manual" | "hsk"
  isVerified Boolean     @default(false)                  // has this been manually verified?

  article    Article?    @relation(fields: [articleId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
}

model Flashcard {
  id             String    @id @default(cuid())
  userId         String
  wordId         Int
  easeFactor     Float     @default(2.5)   // SM-2: difficulty factor (min 1.3)
  interval       Int       @default(0)     // SM-2: days until next review
  repetitions    Int       @default(0)     // SM-2: consecutive successful reviews
  nextReviewAt   DateTime  @default(now()) // SM-2: when this card is next due
  lastReviewedAt DateTime?                 // SM-2: timestamp of last review
  createdAt      DateTime  @default(now())

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  word           Word      @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([userId])
  @@index([userId, nextReviewAt])
}

model ExampleSentence {
  id          Int    @id
  simplified  String
  traditional String
  pinyin      String
  english     String

  @@index([simplified])
}

model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String?  // null for anonymous/unauthenticated enrichment
  wordSimplified   String
  tokensIn         Int
  tokensOut        Int
  estimatedCostUsd Float    // (tokensIn / 1M) * 0.80 + (tokensOut / 1M) * 4.00
  model            String   @default("anthropic/claude-3.5-haiku")
  articleId        Int?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model SubtitleJob {
  id          String   @id @default(cuid())
  status      String   @default("processing") // "processing" | "done" | "failed"
  filename    String   // original uploaded filename
  language    String
  srtContent  String?  // populated when done
  error       String?  // populated when failed
  durationMs  Int?     // total audio duration in ms (from ffprobe)
  progressPct Int      @default(0) // 0–100, updated during transcription
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model TTSCache {
  id            String   @id @default(cuid())
  textHash      String   @unique // SHA-256 hash of text+voice+rate combination
  text          String   // Original text
  voice         String   // Voice name (e.g., "zh-CN-XiaoxiaoNeural")
  rate          String   // Speech rate (e.g., "1.0")
  audioData     String   // Base64 encoded audio
  timings       Json     // Word timings array
  totalDuration Float    // Total audio duration
  segments      Json     // Text segments
  mappings      Json     // TTS mappings
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  @@index([textHash])
  @@index([createdAt])
  @@index([lastUsedAt])
}
